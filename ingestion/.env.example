# --- Input ---
QUAD_FILES_SOURCE=s3://your-bucket/quad_files/
PARAM_BINDINGS_SOURCE=./bindings/

# --- Postgres ---
PG_HOST=your-postgres-host
PG_PORT=5432
PG_DATABASE=knowledge_base
PG_USER=postgres
PG_PASSWORD=your-password

# --- Neptune ---
NEPTUNE_ENDPOINT=your-neptune-cluster.cluster-xyz.us-east-1.neptune.amazonaws.com
NEPTUNE_PORT=8182
NEPTUNE_S3_BUCKET=your-bucket
NEPTUNE_IAM_ROLE=arn:aws:iam::your-account:role/NeptuneS3LoadRole

# --- AWS ---
AWS_REGION=us-east-1

# --- Bedrock (Phase 2 — not needed for ingestion) ---
BEDROCK_MODEL_ARN=arn:aws:bedrock:us-east-1:your-account:application-inference-profile/your-profile
BEDROCK_EMBEDDING_MODEL=arn:aws:bedrock:us-east-1::foundation-model/amazon.titan-embed-text-v2:0
