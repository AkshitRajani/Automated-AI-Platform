# Scoring module config — copy to .env in this same folder (next to __main__.py)
# Then run from the outer scoring/ folder:  py run.py   (or  .\run.ps1)

# Python path — outer scoring folder (same value you would put in PYTHONPATH)
SCORING_ROOT=C:\tools\scoring
# PYTHONPATH=C:\tools\scoring

# Zip mode (default): paths to manual, generated, and optional requirements archives
SCORING_GOLDEN_ZIP=C:\data\manual_features.zip
SCORING_GENERATED_ZIP=C:\data\generated_features.zip
# SCORING_REQUIREMENTS_ZIP=C:\data\requirements.zip

# Folder mode (for `python -m scoring run`): uncomment instead of zips above
# SCORING_GOLDEN=C:\data\feature
# SCORING_GENERATED=C:\data\generated_feature
# SCORING_REQUIREMENTS=C:\data\requirements

# Where score_report.json and score_report.html are written
SCORING_OUTPUT_DIR=C:\data\score_output

# Behaviour match threshold 0..1
SCORING_THRESHOLD=0.5

# Open HTML report in browser after CLI run (true/false)
SCORING_OPEN=false

# Web UI (`python -m scoring serve`)
SCORING_SERVE_HOST=127.0.0.1
SCORING_SERVE_PORT=8766
# SCORING_RUNS_DIR=C:\data\scoring_runs

# --- Bedrock behaviour-profiling agent (Claude Opus 4.8) ---
# Profiling mode: auto | agent | regex
#   auto   = Opus agent when AWS keys are in .env, else regex
#   agent  = always use Opus agent (fails if AWS not configured)
#   regex  = legacy regex profiling (no Bedrock)
SCORING_PROFILING_MODE=auto

# AWS + Bedrock (same as Coding / Requirement / Analyzer agents — do not commit secrets)
# AWS_REGION=us-east-2
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# BEDROCK_MODEL_ARN=us.anthropic.claude-opus-4-8
# Optional override for scoring only (defaults to Opus above):
# SCORING_BEDROCK_MODEL_ARN=us.anthropic.claude-opus-4-8
