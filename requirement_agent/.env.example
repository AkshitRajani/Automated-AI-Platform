# Requirement Agent — environment configuration.
# Copy this file to ".env" (in the directory you run from, or any parent) and fill it in.
# AWS credentials are resolved by the standard boto3 chain (env vars / shared profile /
# instance role) — they do NOT go in this file.

# REQUIRED — the Bedrock model to use: a model id or an inference-profile ARN.
# The agent never defaults a model; if this is unset it fails fast.
BEDROCK_MODEL_ARN=us.anthropic.claude-opus-4-8

# AWS region for Bedrock (default: us-east-1 if unset).
AWS_REGION=us-east-1
